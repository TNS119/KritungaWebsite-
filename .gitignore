# ==========================================
# Kritunga Monorepo .gitignore
# ==========================================

# 1. Dependencies
node_modules/
*/node_modules/
frontend/node_modules/
backend/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# 2. Next.js & Frontend Builds
.next/
frontend/.next/
out/
frontend/out/
.turbo/
.vercel/
frontend/.vercel/
.swc/

# 3. Backend & TypeScript Builds
dist/
backend/dist/
build/
*.tsbuildinfo

# 4. Databases & SQLite Artifacts (Crucial - Never track binary databases)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/prisma/*.db
backend/prisma/*.db-journal
backend/prisma/*.db-wal
backend/prisma/*.db-shm
backend/data/
data/
docker-data/
backend-data/

# 5. Environment & Secret Keys
.env
.env.*
.env*.local
.env.production
.env.staging
.env.development
backend/.env
backend/.env.*
backend/.env*.local
backend/.env.production
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env*.local
frontend/.env.production

# Preserve example templates
!.env.example
!backend/.env.example
!frontend/.env.example

# SSL, Tokens & Security Credentials
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.id_rsa
*.id_ed25519

# 6. Logs & Process Managers
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pm2/
pm2.log
*.pid
*.pid.lock

# 7. Testing & Coverage
coverage/
frontend/coverage/
backend/coverage/
.nyc_output/

# 8. Python & Media Processing Scripts
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# 9. Operating System Metadata
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# 10. IDEs & Agent Workspaces
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
.gemini/
.agents/

# 11. Temporary Files & Scratch Assets
ezgif-*/
scratch/
tmp/
temp/

