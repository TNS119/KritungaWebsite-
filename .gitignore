# ==========================================
# Kritunga Monorepo .gitignore
# ==========================================

# 1. Dependencies
node_modules/
*/node_modules/
frontend/node_modules/
backend/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# 2. Next.js & Frontend Builds
.next/
frontend/.next/
out/
frontend/out/
.turbo/

# 3. Backend & TypeScript Builds
dist/
backend/dist/
build/
*.tsbuildinfo

# 4. Databases & SQLite Artifacts (Crucial - Never track data binaries)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/prisma/*.db
backend/prisma/*.db-journal
backend/prisma/*.db-wal
backend/prisma/*.db-shm
backend/data/
data/

# 5. Environment & Secret Keys
.env
.env*.local
.env.production
.env.staging
backend/.env
backend/.env*.local
frontend/.env.local
frontend/.env*.local

# Preserve example templates
!.env.example
!backend/.env.example
!frontend/.env.example

# SSL & Security Credentials
*.pem
*.key
*.cert
*.crt

# 6. Logs & Process Managers
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pm2/
pm2.log

# 7. Testing & Coverage
coverage/
frontend/coverage/
backend/coverage/
.nyc_output/

# 8. Operating System Metadata
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# 9. IDEs & Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# 10. Temporary Files & Scratch Assets
ezgif-*/
scratch/
tmp/
temp/
