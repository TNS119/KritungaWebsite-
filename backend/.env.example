# =================================================================
# KRITUNGA THE PALEGAR'S CUISINE - BACKEND ENVIRONMENT VARIABLES
# =================================================================

# Server Port
PORT=5000

# Environment Mode: development | test | production
NODE_ENV=production

# Comma-separated allowed frontend origins for CORS
# In production, replace with your actual frontend domain(s)
FRONTEND_URL="https://kritunga.com,https://www.kritunga.com,http://localhost:3000"

# Prisma Database URL
# For SQLite (default): "file:./dev.db" or "file:/app/backend/data/kritunga.db"
# For PostgreSQL: "postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
DATABASE_URL="file:./dev.db"

# WhatsApp Cloud API (Optional - automatically falls back to Click-to-Chat deep links)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_PHONE="+9187XXXXX001"

# Payment Gateway (Optional Test Mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
