# Backend API Base URL
# In local development: leave empty or set to http://localhost:5000
# In production: set to your deployed backend URL (e.g., https://api.kritunga.com)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional Next.js Telemetry Opt-out
NEXT_TELEMETRY_DISABLED=1
